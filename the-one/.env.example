# Your login for the owner side (Likes you, Matches, chat). Required in production.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=pick-a-long-password

# The public address of the site. Used in link previews and notifications.
SITE_URL=https://your-domain.com

# Where the database and uploaded photos live. When deployed, this must be on a
# persistent disk/volume or everything is wiped on each deploy.
DATA_DIR=./data

# PORT=3000

# Optional: get a push notification when someone likes or messages you.
# Works with a Discord webhook, a Slack incoming webhook, or an ntfy.sh topic URL.
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/some-long-random-topic

# Only set this to false if you serve the site over plain http (not recommended).
# COOKIE_SECURE=true
