to": "q3_buy_path_near_cluster"}, {"id": "q4", "type": "mc", "title": "4. Able to ship 275 units to one Manhattan address within ten business days?", "title_standard": "4. Able to ship 550 units to one Manhattan address within ten business days?", "required": true, "options": [["Yes", "Y"], ["No", "N"], ["Not sure", "unsure"]], "maps_to": "q4_can_ship_275_in_10bd"}, {"id": "q5", "type": "mc", "title": "5. Covered by product liability insurance?", "required": true, "options": [["Yes", "Y"], ["No", "N"], ["Not sure", "unsure"]], "maps_to": "q5_product_liability_insurance"}, {"id": "q6", "type": "mc", "title": "6. Can you approve $600 on your own, without a committee?", "title_standard": "6. Can you approve $1,500 on your own, without a committee?", "required": true, "options": [["Yes", "Y"], ["No", "N"], ["Not sure", "unsure"]], "maps_to": "q6_contact_can_approve_600"}, {"id": "q7", "type": "paragraph", "title": "7. Why New York, and why now?", "required": true, "maps_to": "q7_why_now"}, {"id": "excluded", "type": "checkbox", "title": "Not an excluded product", "required": true, "options": [["My product is none of these: alcohol; cannabis, CBD or THC; a dietary supplement; refrigerated or perishable; needs preparation; makes health claims.", "Y"]], "maps_to": "excluded_category_confirmed"}, {"id": "notes", "type": "paragraph", "title": "Notes (optional)", "required": false, "maps_to": "notes"}]}, "survey": {"file_title": "{CAMPAIGN_ID} survey", "form_title": "Three quick questions about {BRAND}", "one_per": "campaign", "response_tab": "{CAMPAIGN_ID}", "description": "Anonymous. No name, no login, no email needed. Your answers go into a short report for {BRAND} and a summary for your office. We may quote your comment word for word, so please leave your name out of it. How we handle this: {PRIVACY_URL}", "description_source": "Legal pack file 13 v0.6, Part A, word for word ([BRAND] and [PRIVACY URL] filled).", "settings": {"collect_email": false, "require_sign_in": fals