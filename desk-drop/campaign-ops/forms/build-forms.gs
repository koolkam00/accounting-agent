function cfg_(name) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("config");
  var rows = sh.getRange(1, 1, sh.getLastRow(), 2).getValues();
  for (var i = 0; i < rows.length; i++) if (rows[i][0] === name) return String(rows[i][1]);
  throw new Error("config has no " + name);
}

function fill_(text, ctx) {
  return String(text).replace(/\{([A-Z_]+)\}/g, function (m, k) { return ctx[k] !== undefined ? ctx[k] : m; });
}

function settings_(form) {
  // Open to people outside your organization (review round 1, R1-01). A Workspace form is restricted to your own
  // domain by default (support.google.com/a/users/answer/9303071, opened 2026-10-24). setRequireLogin is marked
  // deprecated in Google's FormApp reference (opened 2026-10-24) and works only for Workspace accounts, so it is tried
  // here and the manual check stays: Settings > Responses > "Restrict to users in ..." OFF, then open the link in a
  // private window (forms/survey-form.md, Part 1 step 4 and Part 2 step 8).
  try { form.setRequireLogin(false); } catch (e) { Logger.log("setRequireLogin not available here: check Settings > Responses by hand"); }
  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false);
  form.setAllowResponseEdits(false);
  form.setPublishingSummary(false);
  form.setShowLinkToRespondAgain(false);
  form.setProgressBar(false);
}

function options_(item) {
  if (item.options === "CATEGORIES_OFFICE_WITH_ANY") return ["Any of them"].concat(SPEC.categories.map(function (c) { return c[1]; }));
  if (item.options === "CATEGORIES_BRAND") return SPEC.categories.map(function (c) { return c[2]; });
  return (item.options || []).map(function (o) { return o[0]; });
}

function addItem_(form, it, ctx) {
  var title = fill_(it.title, ctx), help = it.help ? fill_(it.help, ctx) : "";
  var x;
  if (it.type === "short") x = form.addTextItem();
  else if (it.type === "paragraph") x = form.addParagraphTextItem();
  else if (it.type === "mc" || it.type === "mc_other") { x = form.addMultipleChoiceItem(); x.setChoiceValues(options_(it).map(function (o) { return fill_(o, ctx); })); if (it.type === "mc_other") x.showOtherOption(true); }
  else if (it.type === "checkbox") { x = form.addCheckboxItem(); x.setChoiceValues(options_(it).map(function (o) { return fill_(o, ctx); })); }
  else if (it.type === "dropdown") { x = form.addListItem(); x.setChoiceValues(options_(it)); }
  else if (it.type === "scale") { x = form.addScaleItem(); x.setBounds(it.low, it.high); x.setLabels(it.low_label, it.high_label); }
  else throw new Error("unknown item type " + it.type);
  x.setTitle(title);
  if (help) x.setHelpText(help);
  x.setRequired(!!it.required);
  return x;
}

function name_(form, fileTitle) {
  DriveApp.getFileById(form.getId()).setName(fileTitle);
}

/** The flat founder-side intake forms. */
function buildIntake_(key) {
  var f = SPEC.forms[key];
  var form = FormApp.create(f.form_title);
  name_(form, f.file_title);
  form.setDescription(f.description);
  settings_(form);
  f.items.forEach(function (it) { addItem_(form, it, {}); });
  form.setDestination(FormApp.DestinationType.SPREADSHEET, SpreadsheetApp.getActiveSpreadsheet().getId());
  return form;
}

/** The survey: four sections, branching on "Did you try". ctx fills {BRAND}, {PRODUCT}, {PRIVACY_URL}. */
function buildSurvey_(ctx, fileTitle) {
  var f = SPEC.forms.survey;
  var form = FormApp.create(fill_(f.form_title, ctx));
  name_(form, fileTitle);
  form.setDescription(fill_(f.description, ctx));
  settings_(form);
  var s = f.sections;
  var byId = {};
  s[0].items.forEach(function (it) { byId[it.id] = addItem_(form, it, ctx); });
  var pages = {};
  for (var k = 1; k < s.length; k++) {
    pages[s[k].id] = form.addPageBreakItem().setTitle(s[k].title);
    s[k].items.forEach(function (it) { byId[it.id] = addItem_(form, it, ctx); });
  }
  // "Did you try": Yes -> section 2, No -> section 3.
  var tried = s[0].items.filter(function (it) { return it.go_to; })[0];
  var mc = byId[tried.id];
  mc.setChoices(tried.options.map(function (o) { return mc.createChoice(o[0], pages[tried.go_to[o[0]]]); }));
  // End of section 2 goes to section 4 (set on the page break that follows section 2, i.e. section 3's).
  pages[s[2].id].setGoToPage(pages[s[1].next]);
  form.setConfirmationMessage(fill_(f.confirmation.always, ctx));
  return { form: form, card: byId.card_code };
}

function buildNewsletter_(ctx, fileTitle) {
  var f = SPEC.forms.newsletter;
  var form = FormApp.create(fill_(f.form_title, ctx));
  name_(form, fileTitle);
  form.setDescription(fill_(f.description, ctx));
  settings_(form);
  f.items.forEach(function (it) { addItem_(form, it, ctx); });
  form.setConfirmationMessage(fill_(f.confirmation, ctx));
  // Never linked to a spreadsheet: consented emails live only in this form's own responses.
  return form;
}

function buildMasters() {
  var ctx = { BRAND: "[BRAND]", PRODUCT: "[PRODUCT]", PRIVACY_URL: cfg_("survey_privacy_url"), BRAND_PRIVACY_URL: "[BRAND PRIVACY POLICY URL]", FOUNDER_EMAIL: cfg_("founder_email") };
  var a = buildSurvey_(ctx, "survey master");
  var b = buildNewsletter_(ctx, "newsletter master");
  var c = buildIntake_("office_intake");
  var d = buildIntake_("brand_intake");
  return "Made: survey master, newsletter master, office and brand intake forms. Rename the two new response tabs office_form and brand_form (delete the placeholders first).";
}

function campaignRow_(cid) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("campaigns");
  var head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  var col = {};
  head.forEach(function (h, i) { col[h] = i + 1; });
  var ids = sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues();
  for (var r = 0; r < ids.length; r++) if (ids[r][0] === cid) return { sheet: sh, row: r + 2, col: col, get: function (n) { return String(sh.getRange(r + 2, col[n]).getValue() || ""); } };
  throw new Error("no campaign " + cid + " on the campaigns tab");
}

function makeCampaignSurvey(cid) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss.getSheetByName(cid)) throw new Error("a tab named " + cid + " already exists: this campaign already has a survey");
  var c = campaignRow_(cid);
  var brand = c.get("brand_name"), product = c.get("product_sku");
  if (!brand) throw new Error(cid + " has no brand_name yet");
  var ctx = { BRAND: brand, PRODUCT: product, PRIVACY_URL: cfg_("survey_privacy_url"), BRAND_PRIVACY_URL: c.get("brand_privacy_url") || "[BRAND PRIVACY POLICY URL]", FOUNDER_EMAIL: cfg_("founder_email"), CAMPAIGN_ID: cid };
  var lines = [SPEC.forms.survey.confirmation.always];
  var nlUrl = "";
  if (c.get("newsletter_option") === "Y") {
    var nl = buildNewsletter_(ctx, cid + " newsletter sign-up");
    nlUrl = nl.getPublishedUrl();
    lines.push(fill_(SPEC.forms.survey.confirmation.if_newsletter, { BRAND: brand, NEWSLETTER_URL: nlUrl }));
  }
  if (c.get("landing_url")) {
    var land = c.get("landing_url") + (c.get("landing_url").indexOf("?") >= 0 ? "&" : "?") + "utm_source=office-pantry&utm_medium=survey&utm_campaign=" + cid.toLowerCase();
    lines.push(fill_(SPEC.forms.survey.confirmation.if_landing, { BRAND: brand, LANDING_URL: land }));
  }
  var built = buildSurvey_(ctx, cid + " survey");
  var form = built.form;
  form.setConfirmationMessage(lines.join("\n"));
  var before = ss.getSheets().map(function (s) { return s.getSheetId(); });
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
  SpreadsheetApp.flush();
  var added = ss.getSheets().filter(function (s) { return before.indexOf(s.getSheetId()) < 0; });
  if (added.length !== 1) throw new Error("could not find the new response tab: rename it to " + cid + " by hand");
  added[0].setName(cid);
  var tpl = form.createResponse().withItemResponse(built.card.createResponse("CARDCODE")).toPrefilledUrl();
  c.sheet.getRange(c.row, c.col["survey_form_url"]).setValue(form.getPublishedUrl());
  c.sheet.getRange(c.row, c.col["survey_prefill_template"]).setValue(tpl);
  if (nlUrl) c.sheet.getRange(c.row, c.col["newsletter_form_url"]).setValue(nlUrl);
  return "Made " + cid + " survey" + (nlUrl ? " and sign-up form" : "") + "; tab " + cid + "; prefill template written. Test one link on your phone (forms/survey-form.md, Part 2, step 8).";
}
