{
  "$description": "Design tokens v1.0 (2026-10-23). Mirrors tokens/tokens.css one to one; tests/check-tokens.js fails if they drift. The working name is not stored here (see brand.json).",
  "color": {
    "ink":          { "$type": "color", "$value": "#1F1D1A", "css": "--dd-ink",          "use": "Text, rules, wordmark on light. 16.8:1 on white." },
    "ink-soft":     { "$type": "color", "$value": "#3A3732", "css": "--dd-ink-soft",     "use": "Secondary dark fill and secondary text." },
    "stone":        { "$type": "color", "$value": "#6B675F", "css": "--dd-stone",        "use": "Secondary text only, 5.6:1 on white. Never allergen text." },
    "mist":         { "$type": "color", "$value": "#E6E1D6", "css": "--dd-mist",         "use": "Hairlines and dividers only, never text." },
    "paper":        { "$type": "color", "$value": "#FFFFFF", "css": "--dd-paper",        "use": "Print background is the sheet itself." },
    "paper-warm":   { "$type": "color", "$value": "#F7F3EA", "css": "--dd-paper-warm",   "use": "Screen background. Never flood-print it." },
    "cobalt":       { "$type": "color", "$value": "#2E47C9", "css": "--dd-cobalt",       "use": "The one signal color. White text on it 7.3:1." },
    "cobalt-light": { "$type": "color", "$value": "#9AABFF", "css": "--dd-cobalt-light", "use": "Signal on dark backgrounds, 7.7:1 on ink." },
    "cobalt-tint":  { "$type": "color", "$value": "#E3E8FB", "css": "--dd-cobalt-tint",  "use": "Light fill on screen; ink text on it 13.8:1." },
    "apricot":      { "$type": "color", "$value": "#F4B183", "css": "--dd-apricot",      "use": "Warm accent, small areas only; ink text on it 9.2:1." },
    "placeholder":  { "$type": "color", "$value": "#FFE45C", "css": "--dd-placeholder",  "use": "Highlighter behind any unfilled [BRACKETED] field." },
    "error":        { "$type": "color", "$value": "#B3261E", "css": "--dd-error",        "use": "Template errors, on screen only." },
    "sample":       { "$type": "color", "$value": "#B3261E", "css": "--dd-sample",       "use": "SAMPLE banner." }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Arial Narrow", "Helvetica Neue", "Arial", "sans-serif"], "css": "--dd-font-display", "google_fonts": "Bricolage Grotesque", "license": "SIL Open Font License 1.1", "axes": "opsz 12-96, wdth 75-100, wght 200-800" },
      "text":    { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "system-ui", "Segoe UI", "Roboto", "Arial", "sans-serif"], "css": "--dd-font-text", "google_fonts": "Atkinson Hyperlegible Next", "license": "SIL Open Font License 1.1", "axes": "wght 200-800, italic" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400, "css": "--dd-weight-regular" },
      "semibold": { "$type": "fontWeight", "$value": 600, "css": "--dd-weight-semibold" },
      "bold":     { "$type": "fontWeight", "$value": 700, "css": "--dd-weight-bold" },
      "display":  { "$type": "fontWeight", "$value": 800, "css": "--dd-weight-display", "use": "Display family only." }
    },
    "display-width": {
      "normal":    { "$type": "number", "$value": "100%",  "css": "--dd-display-width-normal" },
      "narrow":    { "$type": "number", "$value": "87.5%", "css": "--dd-display-width-narrow" },
      "condensed": { "$type": "number", "$value": "75%",   "css": "--dd-display-width-condensed", "use": "Floor for long names. Never narrower." }
    },
    "size-screen": {
      "xs":  { "$type": "dimension", "$value": "12px", "css": "--dd-text-xs" },
      "sm":  { "$type": "dimension", "$value": "14px", "css": "--dd-text-sm" },
      "md":  { "$type": "dimension", "$value": "16px", "css": "--dd-text-md" },
      "lg":  { "$type": "dimension", "$value": "18px", "css": "--dd-text-lg" },
      "xl":  { "$type": "dimension", "$value": "22px", "css": "--dd-text-xl" },
      "2xl": { "$type": "dimension", "$value": "28px", "css": "--dd-text-2xl" },
      "3xl": { "$type": "dimension", "$value": "36px", "css": "--dd-text-3xl" },
      "4xl": { "$type": "dimension", "$value": "48px", "css": "--dd-text-4xl" },
      "5xl": { "$type": "dimension", "$value": "64px", "css": "--dd-text-5xl" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.05, "css": "--dd-leading-tight" },
      "snug":  { "$type": "number", "$value": 1.2,  "css": "--dd-leading-snug" },
      "body":  { "$type": "number", "$value": 1.45, "css": "--dd-leading-body" }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.01em", "css": "--dd-tracking-display" },
      "caps":    { "$type": "dimension", "$value": "0.06em",  "css": "--dd-tracking-caps" }
    },
    "print-minimum": {
      "allergen": { "$type": "dimension", "$value": "14pt", "css": "--dd-print-allergen-size", "use": "LOCKED. Tent card allergen text never renders smaller. Chosen from the close-photo test (tests/photo-sim)." },
      "body":     { "$type": "dimension", "$value": "10pt", "css": "--dd-print-body-min", "use": "Any sentence an employee should read." },
      "fine":     { "$type": "dimension", "$value": "7pt",  "css": "--dd-print-fine-min", "use": "Card ID and sheet notes only." }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0",    "css": "--dd-space-0" },
    "1": { "$type": "dimension", "$value": "4px",  "css": "--dd-space-1" },
    "2": { "$type": "dimension", "$value": "8px",  "css": "--dd-space-2" },
    "3": { "$type": "dimension", "$value": "12px", "css": "--dd-space-3" },
    "4": { "$type": "dimension", "$value": "16px", "css": "--dd-space-4", "print": "1/6 in" },
    "5": { "$type": "dimension", "$value": "24px", "css": "--dd-space-5", "print": "1/4 in" },
    "6": { "$type": "dimension", "$value": "32px", "css": "--dd-space-6" },
    "7": { "$type": "dimension", "$value": "48px", "css": "--dd-space-7", "print": "1/2 in" },
    "8": { "$type": "dimension", "$value": "64px", "css": "--dd-space-8" },
    "9": { "$type": "dimension", "$value": "96px", "css": "--dd-space-9", "print": "1 in" }
  },
  "radius": {
    "0":    { "$type": "dimension", "$value": "0",     "css": "--dd-radius-0", "use": "All printed pieces (hand-trimmed corners)." },
    "1":    { "$type": "dimension", "$value": "4px",   "css": "--dd-radius-1" },
    "2":    { "$type": "dimension", "$value": "8px",   "css": "--dd-radius-2" },
    "pill": { "$type": "dimension", "$value": "999px", "css": "--dd-radius-pill" }
  },
  "rule": {
    "hair":  { "$type": "dimension", "$value": "1px", "css": "--dd-rule-hair" },
    "rule":  { "$type": "dimension", "$value": "2px", "css": "--dd-rule" },
    "heavy": { "$type": "dimension", "$value": "4px", "css": "--dd-rule-heavy" }
  },
  "text-style": {
    "brand-name": {
      "css_class": ".dd-brand-name",
      "use": "THE ONE TEXT STYLE FOR THE NAME wherever it is typeset rather than shown as the wordmark image.",
      "fontFamily": "{font.family.display}", "fontWeight": 800, "fontStretch": "100%", "letterSpacing": "-0.01em", "fontVariationSettings": "\"opsz\" 96"
    }
  },
  "dark-mode": {
    "$description": "Screen only. Print is always light.",
    "bg": "#1F1D1A", "surface": "#3A3732", "text": "#F7F3EA", "text-muted": "#C9C3B8", "accent": "#9AABFF", "on-accent": "#1F1D1A", "rule": "#F7F3EA", "hairline": "#4A463F"
  }
}
