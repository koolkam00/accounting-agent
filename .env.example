VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-a-real-key
MODEL_NAME=openai/gpt-oss-120b
# Optional. Pin the Hugging Face revision at launch; record it in reports/environment.json.
MODEL_REVISION=
# Harmony reasoning effort for gpt-oss (low|medium|high). Default low.
REASONING_EFFORT=low
# vLLM image must be >=0.10.0 to serve gpt-oss-120b. Do not reuse v0.27.1.
# Pin VLLM_DOCKER_DIGEST at launch.
VLLM_DOCKER_IMAGE=vllm/vllm-openai:latest
VLLM_DOCKER_DIGEST=
VLLM_BATCH_INVARIANT=1
DATABASE_URL=sqlite:///./accounting_agent.db
AP_ACCOUNT=2000
PROMPT_VERSION=invoice_extraction_v1
SCHEMA_VERSION=1.0.0
POLICY_PATH=config/policy.yaml
TEMPERATURE=0
TOP_P=1
SEED=42
